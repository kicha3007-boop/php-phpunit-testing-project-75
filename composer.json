{
    "name": "hexlet/code",
    "description": "Page loader: downloads a web page with its local resources",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kichigin Sergey"
        }
    ],
    "bin": [
        "bin/page-loader"
    ],
    "autoload": {
        "psr-4": {
            "Downloader\\Exceptions\\": "src/Exceptions/"
        },
        "files": [
            "src/Names.php",
            "src/Html.php",
            "src/Downloader.php"
        ]
    },
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "docopt/docopt": "^1.0",
        "guzzlehttp/guzzle": "^7.3",
        "monolog/monolog": "^3.4",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
